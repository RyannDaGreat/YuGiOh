  "format": "classic",
  "sources": [
    "https://www.masterduelmeta.com/top-decks/master-v/january-2026/endymion/shadow-spector/ehov2",
    "https://r.jina.ai/https://www.masterduelmeta.com/top-decks/master-v/january-2026/endymion/shadow-spector/ehov2",
